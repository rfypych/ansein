# Database connection strings (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require"

# App Security (Min 32 characters random string)
SECRET_KEY="replace-with-a-very-secure-random-secret-key"

# Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES="1440"
REFRESH_TOKEN_EXPIRE_DAYS="7"
BCRYPT_ROUNDS="12"

# Optional: shared auth rate-limit counter (Upstash Redis REST, free tier).
# When BOTH are set, login/register throttling is enforced globally across
# all serverless instances. When unset, a per-instance in-memory limiter is
# used instead (documented limitation, still blocks naive brute force).
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AXxx..."
