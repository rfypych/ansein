# ============================================================
# AnseIn Configuration (env-driven, plug-and-play)
# ============================================================
# Copy to .env and adjust. All values have safe defaults so the
# app can start in "setup mode" even with an unconfigured DB.

# ---- App ----
APP_NAME=AnseIn
APP_ENV=development            # development | production
APP_DEBUG=true
APP_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (MySQL / cPanel friendly) ----
# Leave DATABASE_URL blank to trigger first-run Setup Wizard.
# cPanel example:
#   mysql+pymysql://user_pass@127.0.0.1:3306/user_db?charset=utf8mb4
DATABASE_URL=
DB_POOL_SIZE=5
DB_POOL_RECYCLE=280

# ---- Redis / Celery (optional — gracefully degrades) ----
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---- LLM Providers (BYOK — user supplies their own) ----
# Multiple providers supported; first non-empty wins.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Enrichment APIs (BYOK) ----
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# ---- Security ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=120

# ---- Setup Wizard ----
# When true, app exposes /api/v1/setup/* endpoints and blocks normal API.
SETUP_MODE=auto                # auto | always | never
