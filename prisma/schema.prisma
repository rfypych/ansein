// AnseIn — Prisma schema
// Database: PostgreSQL (Neon Serverless Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ----------------------------------------------------------------- users
model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  hashedPassword String    @map("hashed_password")
  fullName       String    @default("") @map("full_name")
  isActive       Boolean   @default(true) @map("is_active")
  // Role-based access control: "analyst" | "editor" | "admin"
  role           String    @default("analyst")
  // Session revocation counter: embedded in every JWT; logout and password
  // changes bump it, instantly invalidating all previously issued tokens.
  tokenVersion   Int       @default(0) @map("token_version")
  isSuperuser    Boolean   @default(false) @map("is_superuser")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastLoginAt    DateTime? @map("last_login_at")

  settings        UserSettings?
  investigations  Investigation[]
  chatSessions    ChatSession[]
  auditLogs       AuditLog[]
  notes           InvestigationNote[]
  playbooks       Playbook[]

  @@index([isActive])
  @@map("users")
}

model UserSettings {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  openaiApiKey       String   @default("") @map("openai_api_key")
  groqApiKey         String   @default("") @map("groq_api_key")
  virustotalApiKey   String   @default("") @map("virustotal_api_key")
  abuseipdbApiKey    String   @default("") @map("abuseipdb_api_key")
  shodanApiKey       String   @default("") @map("shodan_api_key")
  abusechApiKey      String   @default("") @map("abusech_api_key")
  preferredLlm       String   @default("auto") @map("preferred_llm")
  customLlmApiKey    String   @default("") @map("custom_llm_api_key")
  customLlmBaseUrl   String   @default("") @map("custom_llm_base_url")
  customLlmModel     String   @default("") @map("custom_llm_model")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user_settings")
}

// ------------------------------------------------------- investigations
model Investigation {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String    @default("")
  status         String    @default("pending") // pending | extracting | enriching | analyzing | completed | failed
  severityScore  Float     @default(0) @map("severity_score")
  tags           Json      @default("[]")
  isStarred      Boolean   @default(false) @map("is_starred")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  sources       Source[]
  entities      Entity[]
  relationships Relationship[]
  analysisRuns  AnalysisRun[]
  chatSessions  ChatSession[]
  notes         InvestigationNote[]

  @@index([userId, status])
  @@index([userId, isStarred])
  @@index([createdAt])
  @@map("investigations")
}

// ---------------------------------------------------- investigation notes
model InvestigationNote {
  id              Int      @id @default(autoincrement())
  investigationId Int      @map("investigation_id")
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body            String
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([investigationId, createdAt])
  @@map("investigation_notes")
}

model Source {
  id              Int      @id @default(autoincrement())
  investigationId Int      @map("investigation_id")
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  sourceType      String   @map("source_type") // text | file | url | email
  title           String   @default("")
  content         String   @default("")
  contentHash     String   @default("") @map("content_hash")
  mimeType        String   @default("text/plain") @map("mime_type")
  sizeBytes       Int      @default(0) @map("size_bytes")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([investigationId])
  @@map("sources")
}

// --------------------------------------------------------- entities / rel
model Entity {
  id              Int      @id @default(autoincrement())
  investigationId Int      @map("investigation_id")
  entityType      String   @map("entity_type")
  value           String
  normalized      String   @default("")
  confidence      Float    @default(0.5)
  enrichment      Json     @default("{}")
  isFalsePositive Boolean  @default(false) @map("is_false_positive")
  sourceMethod    String   @default("regex") @map("source_method")
  createdAt       DateTime @default(now()) @map("created_at")

  investigation       Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  relationshipsFrom   Relationship[] @relation("RelationshipSource")
  relationshipsTo     Relationship[] @relation("RelationshipTarget")

  @@index([investigationId, entityType])
  @@index([value])
  @@index([normalized])
  @@map("entities")
}

model Relationship {
  id              Int      @id @default(autoincrement())
  investigationId Int      @map("investigation_id")
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  sourceId        Int      @map("source_id")
  source          Entity   @relation("RelationshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId        Int      @map("target_id")
  target          Entity   @relation("RelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  relationType    String   @map("relation_type")
  weight          Float    @default(1)
  evidence        String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([investigationId])
  @@index([sourceId])
  @@index([targetId])
  @@map("relationships")
}

// --------------------------------------------------------------- analysis
model AnalysisRun {
  id              Int      @id @default(autoincrement())
  investigationId Int      @map("investigation_id")
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  narrative       String   @default("")
  actorHypothesis Json     @default("{}") @map("actor_hypothesis")
  severityScore   Float    @default(0) @map("severity_score")
  recommendations Json     @default("[]")
  hypotheses      Json     @default("[]")
  admiraltyCode   String   @default("C2") @map("admiralty_code")
  confidence      Float    @default(0.5)
  modelUsed       String   @default("") @map("model_used")
  tokensUsed      Int      @default(0) @map("tokens_used")
  provider        String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([investigationId])
  @@map("analysis_runs")
}

// ----------------------------------------------------------------- copilot
model ChatSession {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  investigationId Int?      @map("investigation_id")
  investigation   Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  title           String    @default("New Chat")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  messages ChatMessage[]
  agentTasks AgentTask[]

  @@index([userId])
  @@index([investigationId])
  @@map("chat_sessions")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  sessionId  Int      @map("session_id")
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String
  content    String
  citations  Json     @default("[]")
  tokensUsed Int      @default(0) @map("tokens_used")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}

model AgentTask {
  id          Int      @id @default(autoincrement())
  sessionId   Int      @map("session_id")
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  status      String   @default("todo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([sessionId])
  @@map("agent_tasks")
}

// ----------------------------------------------------------------- audit
model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?     @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  targetType    String   @default("") @map("target_type")
  targetId      Int?     @map("target_id")
  ipAddress     String   @default("") @map("ip_address")
  extraMetadata Json     @default("{}") @map("extra_metadata")
  prevHash      String   @default("") @map("prev_hash")
  entryHash     String   @default("") @map("entry_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------- app config (setup)
model AppConfig {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_config")
}

// -------------------------------------------------- threat feed cache
// Persisted OSINT feed items collected by lazy refresh (see feeds route).
// Lets /app/feeds render instantly from DB and survive upstream outages.
model FeedItem {
  id          Int      @id @default(autoincrement())
  source      String
  itemType    String   @map("item_type")
  indicator   String
  title       String   @default("")
  description String   @default("")
  detail      Json     @default("{}")
  confidence  Float    @default(0.9)
  firstSeen   DateTime @default(now()) @map("first_seen")
  lastSeen    DateTime @default(now()) @updatedAt @map("last_seen")

  @@unique([source, indicator])
  @@index([source, lastSeen])
  @@map("feed_items")
}

// -------------------------------------------------------------- playbooks
model Playbook {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  trigger     String   @default("") @map("trigger")
  actions     Json     @default("[]")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId, enabled])
  @@map("playbooks")
}
